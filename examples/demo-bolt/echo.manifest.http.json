{
  "display_information": {"name": "Echo Bolt"},
  "features": {"bot_user": {"display_name": "echo-bolt", "always_online": true}},
  "oauth_config": {
    "scopes": {"bot": ["chat:write", "chat:write.public", "channels:history", "reactions:write"]}
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "http://localhost:3001/slack/events",
      "bot_events": ["message.channels"]
    },
    "socket_mode_enabled": false
  }
}
