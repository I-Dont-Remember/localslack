{
  "state": "passing",
  "note": "Slack: joining an archived channel is is_archived",
  "source": "llm",
  "setup": [
    {
      "method": "POST",
      "path": "/api/users.list",
      "token": "xoxb-test",
      "capture": {
        "human": "members.0.id"
      }
    },
    {
      "method": "POST",
      "path": "/api/conversations.create",
      "token": "xoxp-{{human}}",
      "params": {
        "name": "fx-join-arch"
      },
      "capture": {
        "chan": "channel.id"
      }
    },
    {
      "method": "POST",
      "path": "/api/conversations.archive",
      "token": "xoxp-{{human}}",
      "params": {
        "channel": "{{chan}}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/api/conversations.join",
    "token": "xoxb-test",
    "params": {
      "channel": "{{chan}}"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "ok": false,
      "error": "is_archived"
    }
  }
}
