{
  "state": "passing",
  "note": "Slack: leaving a channel you are in returns ok",
  "source": "llm",
  "setup": [
    {
      "method": "POST",
      "path": "/api/users.list",
      "token": "xoxb-test",
      "capture": {
        "human": "members.0.id"
      }
    },
    {
      "method": "POST",
      "path": "/api/conversations.create",
      "token": "xoxp-{{human}}",
      "params": {
        "name": "fx-leave"
      },
      "capture": {
        "chan": "channel.id"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/api/conversations.leave",
    "token": "xoxp-{{human}}",
    "params": {
      "channel": "{{chan}}"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
