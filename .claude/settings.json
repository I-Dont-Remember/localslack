{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.cache/go-build",
        "~/go/pkg/mod",
        "~/.cache/uv",
        "~/.cache/golangci-lint",
        "~/.cache/pre-commit"
      ]
    },
    "network": {
      "allowedDomains": [
        "proxy.golang.org",
        "sum.golang.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/claude-hooks/pre-bash-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/claude-hooks/post-edit-fmt.sh"
          }
        ]
      }
    ]
  }
}
